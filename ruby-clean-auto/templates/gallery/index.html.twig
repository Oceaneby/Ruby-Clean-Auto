{% extends 'base.html.twig' %}

{% block title %}Galerie Ruby Clean Auto{% endblock %}

{% block body %}
<section class="py-16 px-6 sm:px-10 md:px-20 lg:px-32 bg-white">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-6">
      Galerie Ruby‑Clean‑Auto
    </h1>
    <p class="text-center text-lg text-gray-600 mb-12">
      Découvrez nos réalisations — photos & vidéos — Explorez, inspirez-vous, et contactez-nous pour redonner vie à votre véhicule.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-4">
      {% for item in pagination %}
        <div class="relative aspect-[2/3] w-full rounded-md overflow-hidden shadow-md">
          {% if item.type == 'photo' %}
            <img
              src="{{ asset('uploads/gallery/' ~ item.imageFilename) }}"
              alt=""
              class="w-full h-full object-cover"
            >
          {% elseif item.type == 'video' %}
            <video controls class="w-full h-48 object-cover bg-black">
              <source src="{{ asset('uploads/gallery/' ~ item.imageFilename) }}" type="video/mp4">
              Votre navigateur ne supporte pas la vidéo.
            </video>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="mt-8 flex justify-center">
      {{ knp_pagination_render(pagination) }}
    </div>
  </div>
</section>
{% endblock %}
